# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env никогда не попадает в git (см. .gitignore).

# --- Telegram ---
BOT_TOKEN=
ADMIN_ID=

# --- LLM ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# --- Поиск ---
EXA_API_KEY=
EXA_ENABLED=false
SEARXNG_URL=http://127.0.0.1:8888

# --- Wildberries Seller API ---
WB_API_KEY=
WB_API_KEY_READONLY=

# --- Ozon Seller API ---
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_API_KEY_2=
OZON_WAREHOUSE_ID=
OZON_SHOP_NAME=

# --- Cloudflare R2 (хостинг фото для Ozon) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Видеообложки (необязательно) ---
MINIMAX_API_KEY=
KIE_API_KEY=

# --- Пути (необязательно) ---
DB_PATH=./data/bot.db
LOG_PATH=./data/bot.log
OZON_TEMPLATES_DIR=./data/templates/ozon
PRICE_LIST_FILE=./data/price_list.xlsx
WATERMARK_PATH=./data/watermark.png
DOWNLOADS_DIR=
REPORTS_DIR=./data/reports
